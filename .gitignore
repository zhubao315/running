# Raw activity files stay local — the site renders from activities.json
# polylines, and importing years of GPX would bloat the repo.
GPX_OUT/*
!GPX_OUT/.gitkeep
FIT_OUT/*
!FIT_OUT/.gitkeep
TCX_OUT/*
!TCX_OUT/.gitkeep
activities/*
!activities/.gitkeep
